# FastAPI Server Port
PORT=8000

# SQLite cache database path (can be Postgres URL in production, e.g. postgresql://user:password@host/db)
DATABASE_URL=sqlite:///data/cache.db

# CORS Allowed Origins (JSON array or comma-separated values)
CORS_ORIGINS=["http://localhost:5173", "http://localhost:3000"]

# Optional: Groq API Key for Llama-3-8b natural-language plan enhancement.
# If omitted, system falls back automatically to rule-based templates.
GROQ_API_KEY=gsk_your_groq_api_key_here
